# Aternos server dynamic IP / address (e.g., yourname.aternos.me)
MC_HOST=yourname.aternos.me

# Aternos dynamic port (found on your Aternos server page, e.g., 23456)
MC_PORT=25565

# Bot in-game nickname
MC_USERNAME=AFK_Bot

# Minecraft version (e.g. 26.3, or leave blank to auto-detect)
MC_VERSION=26.3

# Authentication mode: 'offline' for cracked Aternos servers, or 'microsoft' if using an official paid account
MC_AUTH=offline

# Time to wait (in milliseconds) before reconnecting after being disconnected
RECONNECT_DELAY_MS=15000

# Port for the web server (used by hosting platforms like Render/Koyeb)
PORT=3000

# Set to 'true' if you want RamLaal to start completely muted in chat (default: false)
MUTED=false
