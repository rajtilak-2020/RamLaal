# Target Minecraft Server IP or domain
MC_HOST=your-server-ip.com
MC_PORT=25565

# Bot in-game nickname
MC_USERNAME=RamLaal

# Minecraft version (e.g. 26.3, or leave blank to auto-detect)
MC_VERSION=26.3

# Authentication mode: 'offline' for cracked/offline servers, or 'microsoft' for paid accounts
MC_AUTH=offline

# Time to wait (in milliseconds) before reconnecting after being disconnected
RECONNECT_DELAY_MS=15000

# Port for the web server (used by hosting platforms like Render, Koyeb, Bot-Hosting)
PORT=3000
SERVER_PORT=3000

# Set to 'true' if you want the bot to remain completely silent in chat
MUTED=true

# View & simulation distance in chunks (default: 32 for maximum chunk & farm simulation)
VIEW_DISTANCE=32

