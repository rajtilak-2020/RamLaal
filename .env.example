# Dual Server Mode: Comma-separated list of servers RamLaal will join simultaneously
MC_SERVERS=mc.krajtilak.in:35529,jhaatgao.falixsrv.me:25565

# Fallback single server settings (used if MC_SERVERS is not set)
MC_HOST=mc.krajtilak.in
MC_PORT=35529

# Bot in-game nickname
MC_USERNAME=AFK_Bot

# Minecraft version (e.g. 26.3, or leave blank to auto-detect)
MC_VERSION=26.3

# Authentication mode: 'offline' for cracked Aternos servers, or 'microsoft' if using an official paid account
MC_AUTH=offline

# Time to wait (in milliseconds) before reconnecting after being disconnected
RECONNECT_DELAY_MS=15000

# Port for the web server (used by hosting platforms like Bot-Hosting, Pterodactyl, Render)
PORT=3000
SERVER_PORT=3000

# Set to 'true' if you want RamLaal to start completely muted in chat
MUTED=true

# View & simulation distance in chunks (default: 32 for maximum farm simulation)
VIEW_DISTANCE=32
